{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "test:visual": "scripts/visual.sh",
    "test:visual:update": "scripts/visual.sh --update-snapshots",
    "screenshots:diff": "node scripts/screenshot-diff.ts",
    "demo": "node scripts/demo.ts",
    "demo:publish": "node scripts/publish-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2"
  }
}
